# Copy to .env (cp .env.example .env) and fill in. NEVER commit .env.
# `./setup.sh` can generate the secrets for you.

# ---- domains (create A records for both, pointing at this server's IP) ----
API_DOMAIN=api.firboai.app
GATEWAY_DOMAIN=gateway.firboai.app
FRONTEND_ORIGINS=https://firboai.app

# ---- Firbo API ----
OPENJARVIS_API_KEY=            # long random string (setup.sh generates it)
SUPABASE_URL=https://bfeinnsorgjycivozcau.supabase.co
SUPABASE_PUBLISHABLE_KEY=      # Supabase -> Project Settings -> API -> publishable key (safe to expose, NOT the service role)

# ---- OmniRoute (AI gateway) ----
# Firbo-branded gateway (built by GitHub, see README). Leave empty to use the public image.
OMNIROUTE_IMAGE=
OMNIROUTE_TAG=latest
JWT_SECRET=                    # long random string (setup.sh generates it)
API_KEY_SECRET=                # long random string (setup.sh generates it)
STORAGE_ENCRYPTION_KEY=        # set once by repair.sh; encrypts provider keys in the gateway. Never change or lose it.
MACHINE_ID_SALT=               # set once by repair.sh
INITIAL_PASSWORD=              # password for the gateway dashboard login (choose a strong one)
# After first login: dashboard -> API Keys -> create TWO keys, then fill and re-run `docker compose up -d`:
OMNIROUTE_API_KEY=             # key for inference (used by Firbo API and by the Supabase agent runner)
OMNIROUTE_MANAGEMENT_KEY=      # key with manage scope (lets the Firbo "AI Gateway" page read provider status)

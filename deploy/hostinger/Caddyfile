# Automatic HTTPS (Let's Encrypt). Both names must have an A record pointing at this server first.
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy firbo-api:8000
}

{$GATEWAY_DOMAIN} {
	encode zstd gzip
	reverse_proxy omniroute:20128 {
		# Let the Firbo site (and only it) show the gateway console inside its Admin page.
		header_down -X-Frame-Options
		header_down Content-Security-Policy "frame-ancestors [^;]*" "frame-ancestors 'self' https://{$FRONTEND_DOMAIN:firboai.app}"
	}
}
